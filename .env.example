# Server only. Never commit real values. Copy to .env and fill locally,
# or set the same names in the Render service environment.
#
# GEMMA_BASE_URL is the model service. Leave it empty for the deployed app.
# The deployed app calls Google, and its model id is Gemma.
#
# A local Ollama server is a different choice. It is reached only through GEMMA_BASE_URL,
# at http://127.0.0.1:11434/v1. GEMMA_MODEL is then any tag from `ollama list`.
# People have different models installed. Do not copy the Google id into a local setup
# unless `ollama list` actually shows that tag. A local server does not need GEMMA_API_KEY.
# If GEMMA_BASE_URL is local and GEMMA_MODEL is empty, the server will not guess a model.

# --- Deployed app: Google ---
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_BASE_URL=

# --- Local model service: Ollama ---
# Comment out the deployed GEMMA_MODEL line above, then uncomment these
# and set GEMMA_MODEL to a tag you have pulled:
# GEMMA_API_KEY=
# GEMMA_BASE_URL=http://127.0.0.1:11434/v1
# GEMMA_MODEL=the-tag-from-ollama-list

# Web client id from Google Cloud. Public in the browser. Used only to save studied places.
GOOGLE_CLIENT_ID=

ELEVENLABS_API_KEY=
# Optional. Set this only to use a voice other than the public default.
# A reading works with ELEVENLABS_API_KEY alone.
ELEVENLABS_VOICE_ID=

# Optional. Error reports, plus a sample of traces. Leave empty and nothing is reported.
# Create a Node.js project in the Sentry dashboard, then paste its DSN here and on Render.
# No auth token is required.
SENTRY_DSN=
