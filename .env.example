# Server only. Never commit real values. Copy to .env and fill locally,
# or set the same names in the Render service environment.

GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Optional. Default is Google's OpenAI-compatible Gemma endpoint.
# A local Ollama example: http://127.0.0.1:11434/v1
GEMMA_BASE_URL=

# Web client id from Google Cloud. Public in the browser. Used only to save studied places.
GOOGLE_CLIENT_ID=

ELEVENLABS_API_KEY=
# Optional. Defaults to a public ElevenLabs voice id.
ELEVENLABS_VOICE_ID=
